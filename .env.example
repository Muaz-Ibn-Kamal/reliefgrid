# PostgreSQL connection string (local, or hosted such as Neon / Supabase / Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/reliefgrid"

# Secret used to sign session tokens. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public demo only: protects the five shared demo accounts (no password changes, admins cannot edit them)
# DEMO_MODE=true

# Optional: "Continue with Google" on the sign-in and register pages (the button only appears when both are set).
# Create an OAuth client (type: Web application) in Google Cloud Console -> APIs & Services -> Credentials, and add
# <your site>/api/auth/google/callback as an authorized redirect URI (for local use: http://localhost:3000/api/auth/google/callback).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI=""   # only if your site sits behind a proxy that hides its public address
