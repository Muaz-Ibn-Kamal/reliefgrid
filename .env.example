# PostgreSQL connection string (local, or hosted such as Neon / Supabase / Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/reliefgrid"

# Secret used to sign session tokens. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public demo only: protects the five shared demo accounts (no password changes, admins cannot edit them)
# DEMO_MODE=true
